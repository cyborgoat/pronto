{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pronto",
  "version": "0.1.0",
  "identifier": "app.pronto.dev",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pronto",
        "width": 1120,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520,
        "visible": true
      },
      {
        "label": "launcher",
        "title": "Pronto Launcher",
        "width": 680,
        "height": 214,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "visible": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
